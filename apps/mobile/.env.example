# ─────────────────────────────────────────────
# LETTR MOBILE — Environment Variables
# Expo reads these with the EXPO_PUBLIC_ prefix (Expo SDK 49+)
# Copy this file to .env
# cp apps/mobile/.env.example apps/mobile/.env
# ─────────────────────────────────────────────

# ── API Connection ────────────────────────────
# The URL of the backend API
# Local dev with Expo Go on a physical device:
#   Replace 'localhost' with your computer's local IP address
#   Find it with: ipconfig (Windows) | ifconfig (macOS/Linux) → look for inet 192.168.x.x
#   Example: http://192.168.1.42:4000
# Production: https://your-api.railway.app
# EXPO_PUBLIC_ prefix makes this available in Expo (client-side only)
EXPO_PUBLIC_API_URL=http://192.168.1.x:4000

# ── Google Maps (React Native Maps) ───────────
# Android requires an API key embedded in the app config
# iOS uses the same key
# Get from: https://console.cloud.google.com → APIs → Maps SDK for Android/iOS
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# ── Paystack (Client-side) ────────────────────
# Public key only — used to open Paystack's payment modal in the app
EXPO_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key

# ── App Identity ──────────────────────────────
EXPO_PUBLIC_APP_NAME=Lettr

# ── Expo Project ──────────────────────────────
# Your Expo project ID — found in app.json after running: eas init
# Required for EAS Build and OTA (over-the-air) updates
EXPO_PUBLIC_PROJECT_ID=your-expo-project-id