# LETTR MOBILE — environment variables (copy to .env)
# Expo exposes EXPO_PUBLIC_* values to the app.

# API base URL. On a physical phone use your computer's LAN address, e.g. http://192.168.1.42:4000
EXPO_PUBLIC_API_URL=http://192.168.1.x:4000

# Web app URL — used for tasks that open lettr.ng (listing editor, verification, bank account)
EXPO_PUBLIC_WEB_URL=http://192.168.1.x:3000

# Expo project ID from `eas init` — needed for push notifications in builds
EXPO_PUBLIC_PROJECT_ID=
