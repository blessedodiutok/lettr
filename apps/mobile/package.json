{
  "name": "@lettr/mobile",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "build": "tsc --noEmit",
    "export:android": "expo export --platform android",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint app components",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"fs.rmSync('.expo',{recursive:true,force:true});fs.rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@expo-google-fonts/playfair-display": "0.2.3",
    "@expo-google-fonts/dm-sans": "0.2.3",
    "expo-splash-screen": "0.29.22",
    "expo-image": "55.0.11",
    "@expo/vector-icons": "15.1.1",
    "@hookform/resolvers": "5.4.0",
    "@tanstack/react-query": "5.100.14",
    "axios": "1.16.1",
    "date-fns": "4.3.0",
    "expo": "55.0.26",
    "expo-camera": "55.0.19",
    "expo-document-picker": "55.0.13",
    "expo-image-picker": "55.0.20",
    "expo-notifications": "55.0.23",
    "expo-router": "55.0.16",
    "expo-secure-store": "55.0.14",
    "nativewind": "4.2.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-hook-form": "7.76.1",
    "react-native": "0.83.6",
    "react-native-gesture-handler": "2.30.1",
    "react-native-maps": "1.27.2",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "4.23.0",
    "tailwindcss": "3.4.17",
    "zod": "4.4.3",
    "zustand": "5.0.13",
    "@lettr/types": "workspace:*",
    "@lettr/zod-schemas": "workspace:*",
    "@lettr/utils": "workspace:*",
    "@lettr/config": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "typescript": "6.0.3",
    "vitest": "4.1.7"
  },
  "expo": {
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#1A3C5E"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Lettr needs access to your photos to upload property images."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Lettr needs camera access to capture property photos."
        }
      ],
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ]
    ]
  }
}
