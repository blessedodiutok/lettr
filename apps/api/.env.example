# ─────────────────────────────────────────────
# LETTR API — Environment Variables
# Copy this file to .env and fill in every value
# cp apps/api/.env.example apps/api/.env
# ─────────────────────────────────────────────

# ── Server ───────────────────────────────────
# The port the Express API listens on locally
PORT=4000

# Node environment — controls logging, error verbosity
# Values: development | production | test
NODE_ENV=development

# The public URL of this API (used in email links, CORS origin list)
# Local: http://localhost:4000
# Production: https://your-api.railway.app
API_URL=http://localhost:4000

# The public URL of the web app — used in email links and Paystack callbacks
WEB_URL=http://localhost:3000

# Reverse proxies in front of the API (Next.js rewrites count as one) — used for client IPs
TRUST_PROXY=1

# Allowed CORS origins — comma-separated list of frontend URLs
# Local: http://localhost:3000
# Production: https://lettr.ng,https://www.lettr.ng
CORS_ORIGINS=http://localhost:3000

# ── Database (PostgreSQL) ─────────────────────
# Full connection string for PostgreSQL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Local (from Section A setup): postgresql://lettr_user:lettr_dev_password@localhost:5432/lettr_db
# Production: get this from Supabase → Settings → Database → Connection String (URI mode)
DATABASE_URL=postgresql://lettr_user:lettr_dev_password@localhost:5432/lettr_db?schema=public

# ── Redis ─────────────────────────────────────
# Redis connection URL for OTP storage, rate limiting, caching
# Local: redis://localhost:6379
# Production: get this from Upstash → Redis → REST URL (use ioredis format: rediss://...)
# Leave empty locally to use an in-memory store. Required in production.
REDIS_URL=

# ── JSON Web Tokens (JWT) ─────────────────────
# JWT (JSON Web Token) is a compact, signed token that proves a user is logged in.
# ACCESS_TOKEN_SECRET: signs short-lived tokens (15 min) sent with every API request
# REFRESH_TOKEN_SECRET: signs long-lived tokens (7 days) stored in httpOnly cookies
# Generate strong secrets with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_64_byte_hex_string_generated_locally
JWT_REFRESH_SECRET=replace_with_different_64_byte_hex_string_generated_locally

# How long access tokens live (15 minutes)
JWT_ACCESS_EXPIRES_IN=15m

# How long refresh tokens live (7 days)
JWT_REFRESH_EXPIRES_IN=30d

# ── Cloudinary (Image Storage) ────────────────
# Cloudinary stores all property photos and verification documents
# Get these from: https://cloudinary.com → Dashboard → API Keys
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# The folder inside your Cloudinary account where Lettr uploads go
CLOUDINARY_UPLOAD_FOLDER=lettr

# ── Firebase Admin (Push Notifications) ───────
# Firebase Admin SDK is used to send push notifications to the mobile app
# Get this from: https://console.firebase.google.com
# → Project Settings → Service Accounts → Generate New Private Key
# Paste the ENTIRE contents of the downloaded JSON file as a single-line string
# Tip: cat firebase-service-account.json | python3 -m json.tool --compact
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"..."}

# ── Email (Nodemailer + Resend) ───────────────
# Primary email provider: Resend (https://resend.com)
# Get your API key from: https://resend.com → API Keys → Create API Key
RESEND_API_KEY=re_your_resend_api_key

# The From address used in all outgoing emails
# Must be a verified domain in Resend: https://resend.com → Domains
EMAIL_FROM=hello@lettr.ng

# Fallback SMTP config (used if Resend fails, or for local dev with Mailtrap)
# Mailtrap local testing: https://mailtrap.io → Inboxes → SMTP Settings
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your_mailtrap_user
SMTP_PASS=your_mailtrap_password

# ── Paystack (Payments) ───────────────────────
# Paystack processes all rental payments in Nigeria
# Get these from: https://dashboard.paystack.com → Settings → API Keys & Webhooks
# Use TEST keys for development, LIVE keys for production
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key

# Paystack webhook secret — used to verify that webhook calls are genuinely from Paystack
# Set this in: Paystack Dashboard → Settings → API Keys & Webhooks → Webhook URL
# The secret is shown after you save the webhook URL
PAYSTACK_WEBHOOK_SECRET=your_paystack_webhook_secret

# ── OTP Settings ──────────────────────────────
# How long (in seconds) a one-time password is valid before expiring
# 300 = 5 minutes
OTP_EXPIRY_SECONDS=300

# ── Cookie Settings ───────────────────────────
# Domain for httpOnly refresh token cookies
# Local: leave empty (defaults to localhost)
# Production: .lettr.ng (note the leading dot — allows api.lettr.ng and www.lettr.ng)
COOKIE_DOMAIN=
# Set to true to send real Paystack transfers to landlords when escrow is released
PAYSTACK_TRANSFER_ENABLED=false

# ── Scheduler ─────────────────────────────────
# Lapses offers, releases escrow after handover and sends reminders every 5 minutes
SCHEDULER_ENABLED=true

# ── Local development ─────────────────────────
# Without Paystack, Cloudinary, email or Redis keys the API simulates payments,
# stores uploads in apps/api/.uploads, prints emails (with OTP codes) to the
# console and keeps sessions in memory. None of these fallbacks run in production.
# PRISMA_LOG_QUERIES=true
