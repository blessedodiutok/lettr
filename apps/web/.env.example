# LETTR WEB — environment variables (copy to .env.local)

# Where the Next.js server forwards /api/* (rewrite) and fetches public pages from.
# The browser always calls same-origin /api, so the refresh cookie stays first-party.
# Local: http://localhost:4000   Production: the API's internal or public URL
API_INTERNAL_URL=http://localhost:4000

# Public site URL — used for canonical links and social previews
NEXT_PUBLIC_APP_URL=http://localhost:3000
