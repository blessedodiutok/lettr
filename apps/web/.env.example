# ─────────────────────────────────────────────
# LETTR WEB — Environment Variables
# Copy this file to .env.local (Next.js convention)
# cp apps/web/.env.example apps/web/.env.local
# ─────────────────────────────────────────────

# ── API Connection ────────────────────────────
# The URL of the backend API
# Local: http://localhost:4000 (Next.js rewrites /api/* to this in next.config.ts)
# Production: https://your-api.railway.app
# NEXT_PUBLIC_ prefix makes this available in the browser (client-side code)
NEXT_PUBLIC_API_URL=http://localhost:4000

# ── Google Maps ───────────────────────────────
# Used to render the interactive property map on listings pages
# Get from: https://console.cloud.google.com
# → APIs & Services → Credentials → Create API Key
# Enable these APIs: Maps JavaScript API, Places API, Geocoding API
# NEXT_PUBLIC_ prefix required — this key is used in browser-side code
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# ── Paystack (Client-side) ────────────────────
# The PUBLIC key is safe to expose in the browser — it only initiates payments
# The SECRET key stays on the server (apps/api/.env) — never put it here
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key

# ── App Identity ──────────────────────────────
# Used in metadata, page titles, and og:image generation
NEXT_PUBLIC_APP_NAME=Lettr
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Vercel Analytics ──────────────────────────
# Automatically set by Vercel on deploy — no action needed for local dev
# If you want analytics locally: https://vercel.com/docs/analytics
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=

# ── Feature Flags ────────────────────────────
# Set to "true" to show the map view by default on the listings page
NEXT_PUBLIC_DEFAULT_MAP_VIEW=false

# Enable TanStack Query Devtools in development
# Set to "false" in production
NEXT_PUBLIC_QUERY_DEVTOOLS=true