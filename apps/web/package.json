    "@lettr/zod-schemas": "workspace:*",
    "@tanstack/react-query": "5.100.14",
    "axios": "1.16.1",
    "lucide-react": "1.17.0",
    "motion": "12.40.0",
    "next": "16.2.6",
    "next-themes": "0.4.6",
    "radix-ui": "^1.4.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-hook-form": "7.76.1",
    "zod": "4.4.3",
    "zustand": "5.0.13"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
