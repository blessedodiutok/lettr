{
  "name": "lettr",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.3.0"
  },
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @lettr/api exec prisma generate",
    "db:migrate": "pnpm --filter @lettr/api exec prisma migrate dev",
    "db:seed": "pnpm --filter @lettr/api run db:seed",
    "db:studio": "pnpm --filter @lettr/api exec prisma studio",
    "clean": "turbo run clean && node -e \"fs.rmSync('node_modules',{recursive:true,force:true})\"",
    "test:e2e": "pnpm --filter @lettr/web exec playwright test",
    "db:seed-admin": "pnpm --filter @lettr/api run db:seed-admin",
    "check": "turbo run typecheck lint test"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.3.0",
    "@types/node": "24.10.2",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "8.50.0",
    "@typescript-eslint/parser": "8.50.0",
    "eslint": "9.39.2",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.5.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwindcss": "4.3.0",
    "turbo": "2.9.15",
    "typescript": "6.0.3"
  }
}
